<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>safeexambrowser</id>
    <version>3.9.0</version>
    <title>SafeExamBrowser</title>
    <authors>ETH Zurich</authors>
    <owners>tunisiano</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/SafeExamBrowser/seb-win-refactoring/blob/master/LICENSE.txt</licenseUrl>
    <projectUrl>https://github.com/SafeExamBrowser/seb-win-refactoring</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/tunisiano187/Chocolatey-packages1@f5e25db01428f6c676524f156e50bef7d4c80791/icons/safeexambrowser.png</iconUrl>
    <description>Safe Exam Browser is a web browser environment to carry out e-assessments safely. The software turns any computer temporarily into a secure workstation. It controls access to resources like system functions, other websites and applications and prevents unauthorized resources being used during an exam.</description>
    <summary>Safe Exam Browser is a web browser environment to carry out e-assessments safely.</summary>
    <releaseNotes>https://github.com/SafeExamBrowser/seb-win-refactoring/releases</releaseNotes>
    <copyright>Copyright 2010-2024 ETH Zurich, IT Services</copyright>
    <tags>exams testing security</tags>
    <projectSourceUrl>https://github.com/SafeExamBrowser/seb-win-refactoring</projectSourceUrl>
    <packageSourceUrl>https://github.com/tunisiano187/Chocolatey-packages1/tree/master/automatic/safeexambrowser</packageSourceUrl>
    <docsUrl>https://safeexambrowser.org/about_overview_en.html</docsUrl>
    <dependencies>
      <dependency id="netfx-4.8" version="4.8.0.20220524" />
      <dependency id="webview2-runtime" version="120.0.2210.121" />
      <dependency id="vcredist140" version="14.38.33130" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
